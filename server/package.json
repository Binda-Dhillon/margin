{
  "name": "@margin/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "node ../node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "node ../node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "test": "node ../node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "better-auth": "^1.7.20",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.18",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
