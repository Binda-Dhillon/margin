# Copy to .env and adjust. `npm start` and Docker Compose both read it. Everything here is optional except PUBLIC_URL once
# you serve Margin from anything other than http://localhost:8787.

# The address people type to reach Margin. Use https:// behind a reverse proxy.
PUBLIC_URL=http://localhost:8787

# Signs session cookies. Leave empty to have one generated and kept in /data.
AUTH_SECRET=

# Set to false once everyone has an account, to stop new sign-ups.
ALLOW_SIGNUP=true

# "Continue with university account": fill in either or both.
# Redirect URI to register with the provider:
#   <PUBLIC_URL>/api/auth/callback/microsoft
#   <PUBLIC_URL>/api/auth/callback/google
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" accepts any Microsoft work, school or personal account. Use your
# university's tenant ID to accept only its accounts.
MICROSOFT_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email for "Forgot password?" links. Leave SMTP_HOST empty to hide the option.
# Gmail: smtp.gmail.com, port 587, your address as SMTP_USER and an app
# password (Google Account > Security > App passwords) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on the email. Defaults to SMTP_USER.
SMTP_FROM=
